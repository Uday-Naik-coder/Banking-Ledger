      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.variables.set('idempotencyKey', 'pm-deposit-' + Date.now() + '-' + Math.floor(Math.random() * 100000));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 or 200', function () { pm.expect([200, 201]).to.include(pm.response.code); });"
            ],
            "type": "text/javascript"
          }
        }
