# Server Port (Render dynamically provides PORT)
PORT=3000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Atlas / Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/banking_ledger?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Client URL (e.g. https://your-banking-app.onrender.com or http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Optional: Transaction Processing Delay (ms) for demo simulation (default: 0)
TRANSACTION_DELAY_MS=0

# Email Service (Nodemailer OAuth2 / Gmail)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
REFRESH_TOKEN=your_google_oauth_refresh_token
